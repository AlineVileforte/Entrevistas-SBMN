  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>DCE1-Par2</incoming>
      <outgoing>Par2-NCF1</outgoing>
      <outgoing>Par2-PP1</outgoing>
    </parallelGateway>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>Par2-NCF1</incoming>
      <outgoing>NCF1-Par8</outgoing>
    </task>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>Par2-PP1</incoming>
      <outgoing>PP1-DVSE1</outgoing>
    </task>
    <task id="DVSE1" name="Desenvolver e Validar Software Embarcado">
      <incoming>PP1-DVSE1</incoming>
      <outgoing>DVSE1-PLP1</outgoing>
    </task>
    <parallelGateway id="Par8" name="PAR">
      <incoming>NCF1-Par8</incoming>
      <outgoing>Par8-PCS1</outgoing>
      <outgoing>Par8-AACL1</outgoing>
    </parallelGateway>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>Par8-PCS1</incoming>
      <outgoing>PCS1-PARCLOSE12</outgoing>
    </task>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>Par8-AACL1</incoming>
      <outgoing>AACL1-PARCLOSE12</outgoing>
    </task>
    <task id="PLP1" name="Preparar Linha de Produção">
      <incoming>DVSE1-PLP1</incoming>
      <outgoing>PLP1-PARCLOSE14</outgoing>
    </task>
    <parallelGateway id="PARCLOSE12" name="PARCLOSE12">
      <incoming>PCS1-PARCLOSE12</incoming>
      <incoming>AACL1-PARCLOSE12</incoming>
      <outgoing>PARCLOSE12-PARCLOSE14</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE14" name="PARCLOSE14">
      <incoming>PLP1-PARCLOSE14</incoming>
      <incoming>PARCLOSE12-PARCLOSE14</incoming>
      <outgoing>PARCLOSE14-RI1</outgoing>
    </parallelGateway>
    <task id="RI1" name="Realizar Inspeções">
      <incoming>PARCLOSE14-RI1</incoming>
      <outgoing>RI1-MDT1</outgoing>
    </task>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>RI1-MDT1</incoming>
      <outgoing>MDT1-CDT1</outgoing>
    </task>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>MDT1-CDT1</incoming>
      <outgoing>CDT1-Par18</outgoing>
    </task>
    <parallelGateway id="Par18" name="PAR">
      <incoming>CDT1-Par18</incoming>
      <outgoing>Par18-RTM1</outgoing>
      <outgoing>Par18-PMT1</outgoing>
    </parallelGateway>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>Par18-RTM1</incoming>
      <outgoing>RTM1-VF1</outgoing>
    </task>
    <task id="PMT1" name="Preparar Materiais de Treinamento">
      <incoming>Par18-PMT1</incoming>
      <outgoing>PMT1-PARCLOSE22</outgoing>
    </task>
    <task id="VF1" name="Validação Final">
      <incoming>RTM1-VF1</incoming>
      <outgoing>VF1-PARCLOSE22</outgoing>
    </task>
    <parallelGateway id="PARCLOSE22" name="PARCLOSE22">
      <incoming>PMT1-PARCLOSE22</incoming>
      <incoming>VF1-PARCLOSE22</incoming>
      <outgoing>PARCLOSE22-APLE1</outgoing>
    </parallelGateway>
    <task id="APLE1" name="Autorizar Produção em Larga Escala">
      <incoming>PARCLOSE22-APLE1</incoming>
      <outgoing>APLE1-END</outgoing>
    </task>
    <endEvent id="END" name="END_EVENT">
      <incoming>APLE1-END</incoming>
    </endEvent>
