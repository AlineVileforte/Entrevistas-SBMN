<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_d51f71f7-0218-45c0-9435-b37272ad0f28" targetNamespace="http://camunda.org/examples" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-NCF1</outgoing>
    </task>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>DCE1-NCF1</incoming>
      <outgoing>NCF1-Par3</outgoing>
    </task>
    <parallelGateway id="Par3" name="PAR">
      <incoming>NCF1-Par3</incoming>
      <outgoing>Par3-AACL1</outgoing>
      <outgoing>Par3-PCS1</outgoing>
    </parallelGateway>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>Par3-AACL1</incoming>
      <outgoing>AACL1-PP1</outgoing>
    </task>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>AACL1-PP1</incoming>
      <outgoing>PP1-DVSE1</outgoing>
    </task>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>Par3-PCS1</incoming>
      <outgoing>PCS1-G1</outgoing>
    </task>
    <task id="DVSE1" name="Desenvolver e Validar Software Embarcado">
      <incoming>PP1-DVSE1</incoming>
      <outgoing>DVSE1-PLP1</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>PCS1-G1</incoming>
      <outgoing>G1-MDT1</outgoing>
      <outgoing>G1-XORCLOSE14</outgoing>
    </exclusiveGateway>
    <task id="PLP1" name="Preparar Linha de Produção">
      <incoming>DVSE1-PLP1</incoming>
      <outgoing>PLP1-RI1</outgoing>
    </task>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>G1-MDT1</incoming>
      <outgoing>MDT1-RTM1</outgoing>
    </task>
    <task id="RI1" name="Realizar Inspeções">
      <incoming>PLP1-RI1</incoming>
      <outgoing>RI1-PARCLOSE21</outgoing>
    </task>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>MDT1-RTM1</incoming>
      <outgoing>RTM1-XORCLOSE14</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE14" name="XORCLOSE14">
      <incoming>G1-XORCLOSE14</incoming>
      <incoming>RTM1-XORCLOSE14</incoming>
      <outgoing>XORCLOSE14-VF1</outgoing>
    </exclusiveGateway>
    <task id="VF1" name="Validação Final">
      <incoming>XORCLOSE14-VF1</incoming>
      <outgoing>VF1-Par16</outgoing>
    </task>
    <parallelGateway id="Par16" name="PAR">
      <incoming>VF1-Par16</incoming>
      <outgoing>Par16-APLE1</outgoing>
      <outgoing>Par16-CDT1</outgoing>
    </parallelGateway>
    <task id="APLE1" name="Autorizar Produção em Larga Escala">
      <incoming>Par16-APLE1</incoming>
      <outgoing>APLE1-PARCLOSE20</outgoing>
    </task>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>Par16-CDT1</incoming>
      <outgoing>CDT1-PMT1</outgoing>
    </task>
    <task id="PMT1" name="Preparar Materiais de Treinamento">
      <incoming>CDT1-PMT1</incoming>
      <outgoing>PMT1-PARCLOSE20</outgoing>
    </task>
    <parallelGateway id="PARCLOSE20" name="PARCLOSE20">
      <incoming>APLE1-PARCLOSE20</incoming>
      <incoming>PMT1-PARCLOSE20</incoming>
      <outgoing>PARCLOSE20-PARCLOSE21</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE21" name="PARCLOSE21">
      <incoming>RI1-PARCLOSE21</incoming>
      <incoming>PARCLOSE20-PARCLOSE21</incoming>
      <outgoing>PARCLOSE21-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE21-END</incoming>
    </endEvent>
