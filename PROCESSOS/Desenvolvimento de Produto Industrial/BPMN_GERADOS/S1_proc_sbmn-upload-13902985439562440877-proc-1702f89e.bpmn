<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_372ee121-ca73-4dbf-93fa-5abcd2301ef7" targetNamespace="http://camunda.org/examples" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-NCF1</outgoing>
    </task>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>DCE1-NCF1</incoming>
      <outgoing>NCF1-Par3</outgoing>
    </task>
    <parallelGateway id="Par3" name="PAR">
      <incoming>NCF1-Par3</incoming>
      <outgoing>Par3-PP1</outgoing>
      <outgoing>Par3-AACL1</outgoing>
    </parallelGateway>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>Par3-PP1</incoming>
      <outgoing>PP1-Par5</outgoing>
    </task>
    <parallelGateway id="Par5" name="PAR">
      <incoming>PP1-Par5</incoming>
      <outgoing>Par5-DVSE1</outgoing>
      <outgoing>Par5-G0</outgoing>
    </parallelGateway>
    <task id="DVSE1" name="Desenvolver e Validar Software Embarcado">
      <incoming>Par5-DVSE1</incoming>
      <outgoing>DVSE1-PLP1</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>Par5-G0</incoming>
      <outgoing>G0-MDT1</outgoing>
      <outgoing>G0-XORCLOSE15</outgoing>
    </exclusiveGateway>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>Par3-AACL1</incoming>
      <outgoing>AACL1-PCS1</outgoing>
    </task>
    <task id="PLP1" name="Preparar Linha de Produção">
      <incoming>DVSE1-PLP1</incoming>
      <outgoing>PLP1-RI1</outgoing>
    </task>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>G0-MDT1</incoming>
      <outgoing>MDT1-RTM1</outgoing>
    </task>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>AACL1-PCS1</incoming>
      <outgoing>PCS1-PARCLOSE23</outgoing>
    </task>
    <task id="RI1" name="Realizar Inspeções">
      <incoming>PLP1-RI1</incoming>
      <outgoing>RI1-PARCLOSE22</outgoing>
    </task>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>MDT1-RTM1</incoming>
      <outgoing>RTM1-XORCLOSE15</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE15" name="XORCLOSE15">
      <incoming>G0-XORCLOSE15</incoming>
      <incoming>RTM1-XORCLOSE15</incoming>
      <outgoing>XORCLOSE15-CDT1</outgoing>
    </exclusiveGateway>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>XORCLOSE15-CDT1</incoming>
      <outgoing>CDT1-Par17</outgoing>
    </task>
    <parallelGateway id="Par17" name="PAR">
      <incoming>CDT1-Par17</incoming>
      <outgoing>Par17-VF1</outgoing>
      <outgoing>Par17-PMT1</outgoing>
    </parallelGateway>
    <task id="VF1" name="Validação Final">
      <incoming>Par17-VF1</incoming>
      <outgoing>VF1-APLE1</outgoing>
    </task>
    <task id="PMT1" name="Preparar Materiais de Treinamento">
      <incoming>Par17-PMT1</incoming>
      <outgoing>PMT1-PARCLOSE21</outgoing>
    </task>
    <task id="APLE1" name="Autorizar Produção em Larga Escala">
      <incoming>VF1-APLE1</incoming>
      <outgoing>APLE1-PARCLOSE21</outgoing>
    </task>
    <parallelGateway id="PARCLOSE21" name="PARCLOSE21">
      <incoming>PMT1-PARCLOSE21</incoming>
      <incoming>APLE1-PARCLOSE21</incoming>
      <outgoing>PARCLOSE21-PARCLOSE22</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE22" name="PARCLOSE22">
      <incoming>RI1-PARCLOSE22</incoming>
      <incoming>PARCLOSE21-PARCLOSE22</incoming>
      <outgoing>PARCLOSE22-PARCLOSE23</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE23" name="PARCLOSE23">
      <incoming>PCS1-PARCLOSE23</incoming>
      <incoming>PARCLOSE22-PARCLOSE23</incoming>
      <outgoing>PARCLOSE23-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE23-END</incoming>
    </endEvent>
