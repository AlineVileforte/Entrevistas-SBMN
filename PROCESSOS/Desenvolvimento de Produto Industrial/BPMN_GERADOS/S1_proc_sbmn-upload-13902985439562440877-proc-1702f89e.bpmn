    <sequenceFlow id="Par17-VF1" sourceRef="Par17" targetRef="VF1"/>
    <sequenceFlow id="Par17-PMT1" sourceRef="Par17" targetRef="PMT1"/>
    <sequenceFlow id="VF1-APLE1" sourceRef="VF1" targetRef="APLE1"/>
    <sequenceFlow id="PMT1-PARCLOSE21" sourceRef="PMT1" targetRef="PARCLOSE21"/>
    <sequenceFlow id="APLE1-PARCLOSE21" sourceRef="APLE1" targetRef="PARCLOSE21"/>
    <sequenceFlow id="PARCLOSE21-PARCLOSE22" sourceRef="PARCLOSE21" targetRef="PARCLOSE22"/>
    <sequenceFlow id="PARCLOSE22-PARCLOSE23" sourceRef="PARCLOSE22" targetRef="PARCLOSE23"/>
    <sequenceFlow id="PARCLOSE23-END" sourceRef="PARCLOSE23" targetRef="END"/>
  </process>
