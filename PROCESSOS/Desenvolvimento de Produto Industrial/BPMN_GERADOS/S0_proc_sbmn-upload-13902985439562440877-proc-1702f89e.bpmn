      <outgoing>PARCLOSE15-Par16</outgoing>
    </parallelGateway>
    <parallelGateway id="Par16" name="PAR">
      <incoming>PARCLOSE15-Par16</incoming>
      <outgoing>Par16-VF1</outgoing>
      <outgoing>Par16-CDT1</outgoing>
    </parallelGateway>
    <task id="VF1" name="Validação Final">
      <incoming>Par16-VF1</incoming>
      <outgoing>VF1-Par19</outgoing>
    </task>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>Par16-CDT1</incoming>
      <outgoing>CDT1-PMT1</outgoing>
    </task>
    <parallelGateway id="Par19" name="PAR">
      <incoming>VF1-Par19</incoming>
      <outgoing>Par19-DVSE1</outgoing>
      <outgoing>Par19-APLE1</outgoing>
