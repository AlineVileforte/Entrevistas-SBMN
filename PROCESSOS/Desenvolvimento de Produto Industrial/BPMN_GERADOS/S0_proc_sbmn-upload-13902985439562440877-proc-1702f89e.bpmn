  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>DCE1-Par2</incoming>
      <outgoing>Par2-NCF1</outgoing>
      <outgoing>Par2-PP1</outgoing>
    </parallelGateway>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>Par2-NCF1</incoming>
      <outgoing>NCF1-Par5</outgoing>
    </task>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>Par2-PP1</incoming>
      <outgoing>PP1-G0</outgoing>
    </task>
    <parallelGateway id="Par5" name="PAR">
      <incoming>NCF1-Par5</incoming>
      <outgoing>Par5-PCS1</outgoing>
      <outgoing>Par5-AACL1</outgoing>
    </parallelGateway>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>Par5-PCS1</incoming>
      <outgoing>PCS1-PARCLOSE11</outgoing>
    </task>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>Par5-AACL1</incoming>
      <outgoing>AACL1-PARCLOSE11</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>PP1-G0</incoming>
      <outgoing>G0-MDT1</outgoing>
      <outgoing>G0-XORCLOSE14</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE11" name="PARCLOSE11">
      <incoming>PCS1-PARCLOSE11</incoming>
      <incoming>AACL1-PARCLOSE11</incoming>
      <outgoing>PARCLOSE11-PARCLOSE15</outgoing>
    </parallelGateway>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>G0-MDT1</incoming>
      <outgoing>MDT1-RTM1</outgoing>
    </task>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>MDT1-RTM1</incoming>
      <outgoing>RTM1-XORCLOSE14</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE14" name="XORCLOSE14">
      <incoming>G0-XORCLOSE14</incoming>
      <incoming>RTM1-XORCLOSE14</incoming>
      <outgoing>XORCLOSE14-PARCLOSE15</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE15" name="PARCLOSE15">
      <incoming>PARCLOSE11-PARCLOSE15</incoming>
