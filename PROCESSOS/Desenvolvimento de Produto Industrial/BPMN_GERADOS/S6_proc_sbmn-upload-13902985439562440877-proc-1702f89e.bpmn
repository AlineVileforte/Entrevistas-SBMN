  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>DCE1-Par2</incoming>
      <outgoing>Par2-NCF1</outgoing>
      <outgoing>Par2-PP1</outgoing>
    </parallelGateway>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>Par2-NCF1</incoming>
      <outgoing>NCF1-AACL1</outgoing>
    </task>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>Par2-PP1</incoming>
      <outgoing>PP1-DVSE1</outgoing>
    </task>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>NCF1-AACL1</incoming>
      <outgoing>AACL1-PCS1</outgoing>
    </task>
    <task id="DVSE1" name="Desenvolver e Validar Software Embarcado">
      <incoming>PP1-DVSE1</incoming>
      <outgoing>DVSE1-Par10</outgoing>
    </task>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>AACL1-PCS1</incoming>
      <outgoing>PCS1-PARCLOSE26</outgoing>
    </task>
    <parallelGateway id="Par10" name="PAR">
      <incoming>DVSE1-Par10</incoming>
      <outgoing>Par10-PLP1</outgoing>
      <outgoing>Par10-G1</outgoing>
    </parallelGateway>
    <task id="PLP1" name="Preparar Linha de Produção">
      <incoming>Par10-PLP1</incoming>
      <outgoing>PLP1-RI1</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>Par10-G1</incoming>
      <outgoing>G1-MDT1</outgoing>
      <outgoing>G1-XORCLOSE18</outgoing>
    </exclusiveGateway>
    <task id="RI1" name="Realizar Inspeções">
      <incoming>PLP1-RI1</incoming>
      <outgoing>RI1-PARCLOSE25</outgoing>
    </task>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>G1-MDT1</incoming>
      <outgoing>MDT1-RTM1</outgoing>
    </task>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>MDT1-RTM1</incoming>
      <outgoing>RTM1-XORCLOSE18</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE18" name="XORCLOSE18">
      <incoming>G1-XORCLOSE18</incoming>
      <incoming>RTM1-XORCLOSE18</incoming>
      <outgoing>XORCLOSE18-Par19</outgoing>
    </exclusiveGateway>
    <parallelGateway id="Par19" name="PAR">
      <incoming>XORCLOSE18-Par19</incoming>
      <outgoing>Par19-VF1</outgoing>
      <outgoing>Par19-CDT1</outgoing>
    </parallelGateway>
    <task id="VF1" name="Validação Final">
      <incoming>Par19-VF1</incoming>
      <outgoing>VF1-APLE1</outgoing>
    </task>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>Par19-CDT1</incoming>
      <outgoing>CDT1-PARCLOSE23</outgoing>
    </task>
    <task id="APLE1" name="Autorizar Produção em Larga Escala">
      <incoming>VF1-APLE1</incoming>
      <outgoing>APLE1-PARCLOSE23</outgoing>
    </task>
    <parallelGateway id="PARCLOSE23" name="PARCLOSE23">
      <incoming>CDT1-PARCLOSE23</incoming>
      <incoming>APLE1-PARCLOSE23</incoming>
      <outgoing>PARCLOSE23-PMT1</outgoing>
    </parallelGateway>
    <task id="PMT1" name="Preparar Materiais de Treinamento">
      <incoming>PARCLOSE23-PMT1</incoming>
      <outgoing>PMT1-PARCLOSE25</outgoing>
    </task>
    <parallelGateway id="PARCLOSE25" name="PARCLOSE25">
      <incoming>RI1-PARCLOSE25</incoming>
      <incoming>PMT1-PARCLOSE25</incoming>
      <outgoing>PARCLOSE25-PARCLOSE26</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE26" name="PARCLOSE26">
      <incoming>PCS1-PARCLOSE26</incoming>
      <incoming>PARCLOSE25-PARCLOSE26</incoming>
      <outgoing>PARCLOSE26-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE26-END</incoming>
    </endEvent>
