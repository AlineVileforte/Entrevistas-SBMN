  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
    <task id="DCE1" name="Desenvolver Componentes Estruturais">
      <incoming>ACP1-DCE1</incoming>
      <outgoing>DCE1-PP1</outgoing>
    </task>
    <task id="PP1" name="Produzir Protótipos">
      <incoming>DCE1-PP1</incoming>
      <outgoing>PP1-Par3</outgoing>
    </task>
    <parallelGateway id="Par3" name="PAR">
      <incoming>PP1-Par3</incoming>
      <outgoing>Par3-DVSE1</outgoing>
      <outgoing>Par3-G0</outgoing>
    </parallelGateway>
    <exclusiveGateway id="G0" name="G0">
      <incoming>Par3-G0</incoming>
      <outgoing>G0-MDT1</outgoing>
      <outgoing>G0-XORCLOSE14</outgoing>
    </exclusiveGateway>
    <task id="DVSE1" name="Desenvolver e Validar Software Embarcado">
      <incoming>Par3-DVSE1</incoming>
      <outgoing>DVSE1-Par8</outgoing>
    </task>
    <task id="MDT1" name="Modificar Desenhos Técnicos">
      <incoming>G0-MDT1</incoming>
      <outgoing>MDT1-RTM1</outgoing>
    </task>
    <parallelGateway id="Par8" name="PAR">
      <incoming>DVSE1-Par8</incoming>
      <outgoing>Par8-NCF1</outgoing>
      <outgoing>Par8-PLP1</outgoing>
    </parallelGateway>
    <task id="NCF1" name="Negociar com Fornecedores">
      <incoming>Par8-NCF1</incoming>
      <outgoing>NCF1-PCS1</outgoing>
    </task>
    <task id="PLP1" name="Preparar Linha de Produção">
      <incoming>Par8-PLP1</incoming>
      <outgoing>PLP1-RI1</outgoing>
    </task>
    <task id="RTM1" name="Realizar Testes Mecânicos">
      <incoming>MDT1-RTM1</incoming>
      <outgoing>RTM1-XORCLOSE14</outgoing>
    </task>
    <task id="PCS1" name="Projetar Circuitos e Sensores">
      <incoming>NCF1-PCS1</incoming>
      <outgoing>PCS1-AACL1</outgoing>
    </task>
    <task id="RI1" name="Realizar Inspeções">
      <incoming>PLP1-RI1</incoming>
      <outgoing>RI1-PARCLOSE16</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE14" name="XORCLOSE14">
      <incoming>G0-XORCLOSE14</incoming>
      <incoming>RTM1-XORCLOSE14</incoming>
      <outgoing>XORCLOSE14-CDT1</outgoing>
    </exclusiveGateway>
    <task id="AACL1" name="Atualizar Análise de Custos e Logística">
      <incoming>PCS1-AACL1</incoming>
      <outgoing>AACL1-PARCLOSE16</outgoing>
    </task>
    <parallelGateway id="PARCLOSE16" name="PARCLOSE16">
      <incoming>RI1-PARCLOSE16</incoming>
      <incoming>AACL1-PARCLOSE16</incoming>
      <outgoing>PARCLOSE16-PARCLOSE19</outgoing>
    </parallelGateway>
    <task id="CDT1" name="Consolidar Documentação Técnica">
      <incoming>XORCLOSE14-CDT1</incoming>
      <outgoing>CDT1-VF1</outgoing>
    </task>
    <task id="VF1" name="Validação Final">
      <incoming>CDT1-VF1</incoming>
      <outgoing>VF1-PARCLOSE19</outgoing>
    </task>
    <parallelGateway id="PARCLOSE19" name="PARCLOSE19">
      <incoming>PARCLOSE16-PARCLOSE19</incoming>
      <incoming>VF1-PARCLOSE19</incoming>
      <outgoing>PARCLOSE19-APLE1</outgoing>
    </parallelGateway>
    <task id="APLE1" name="Autorizar Produção em Larga Escala">
      <incoming>PARCLOSE19-APLE1</incoming>
      <outgoing>APLE1-PMT1</outgoing>
    </task>
    <task id="PMT1" name="Preparar Materiais de Treinamento">
      <incoming>APLE1-PMT1</incoming>
      <outgoing>PMT1-END</outgoing>
    </task>
    <endEvent id="END" name="END_EVENT">
      <incoming>PMT1-END</incoming>
    </endEvent>
