  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-ACP1</outgoing>
    </startEvent>
    <task id="ACP1" name="Aprovar Conceito do Produto">
      <incoming>Default_init-ACP1</incoming>
      <outgoing>ACP1-DCE1</outgoing>
    </task>
