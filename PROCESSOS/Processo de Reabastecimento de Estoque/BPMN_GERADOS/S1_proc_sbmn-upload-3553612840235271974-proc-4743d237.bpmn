<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_3d64c08a-75d5-4866-8761-b5a41236638c" targetNamespace="http://camunda.org/examples" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-VNAE1</outgoing>
    </startEvent>
    <task id="VNAE1" name="Verificar Nível Atual de Estoque">
      <incoming>Default_init-VNAE1</incoming>
      <outgoing>VNAE1-G0</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>VNAE1-G0</incoming>
      <outgoing>G0-CPC1</outgoing>
      <outgoing>G0-XORCLOSE21</outgoing>
    </exclusiveGateway>
    <task id="CPC1" name="Criar Pedido de Compra">
      <incoming>G0-CPC1</incoming>
      <outgoing>CPC1-XOR_JMPBB_RTPC1_RPC1</outgoing>
    </task>
    <task id="RPC1" name="Revisar Pedido de Compra">
      <incoming>XOR_JMPBB_RTPC1_RPC1-RPC1</incoming>
      <outgoing>RPC1-G1</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>RPC1-G1</incoming>
      <outgoing>G1-RTPC1</outgoing>
      <outgoing>G1-XORCLOSE20</outgoing>
    </exclusiveGateway>
    <task id="RTPC1" name="Retrabalhar Pedido de Compra">
      <incoming>G1-RTPC1</incoming>
      <outgoing>RTPC1-XOR_JMPAA_RTPC1_RPC1</outgoing>
    </task>
    <task id="APC1" name="Aprovar Pedido de Compra">
      <incoming>XOR_JMPAA_RTPC1_RPC1-APC1</incoming>
      <outgoing>APC1-EPCF1</outgoing>
    </task>
    <task id="EPCF1" name="Enviar Pedido de Compra ao Fornecedor">
      <incoming>APC1-EPCF1</incoming>
      <outgoing>EPCF1-RRF1</outgoing>
    </task>
    <task id="RRF1" name="Reservar Recursos Financeiros para a Compra">
      <incoming>EPCF1-RRF1</incoming>
      <outgoing>RRF1-RFatP1</outgoing>
    </task>
    <task id="RFatP1" name="Receber Fatura do Pedido">
      <incoming>RRF1-RFatP1</incoming>
      <outgoing>RFatP1-Par13</outgoing>
    </task>
    <parallelGateway id="Par13" name="PAR">
      <incoming>RFatP1-Par13</incoming>
      <outgoing>Par13-RREP1</outgoing>
      <outgoing>Par13-RGFatP1</outgoing>
    </parallelGateway>
    <task id="RREP1" name="Receber Romaneio de Entrega do Pedido">
      <incoming>Par13-RREP1</incoming>
      <outgoing>RREP1-PARCLOSE16</outgoing>
    </task>
    <task id="RGFatP1" name="Registrar Fatura do Pedido">
      <incoming>Par13-RGFatP1</incoming>
      <outgoing>RGFatP1-PARCLOSE16</outgoing>
    </task>
    <parallelGateway id="PARCLOSE16" name="PARCLOSE16">
      <incoming>RREP1-PARCLOSE16</incoming>
      <incoming>RGFatP1-PARCLOSE16</incoming>
      <outgoing>PARCLOSE16-RGREP1</outgoing>
    </parallelGateway>
    <task id="RGREP1" name="Registrar Romaneio de Entrega do Pedido">
      <incoming>PARCLOSE16-RGREP1</incoming>
      <outgoing>RGREP1-LRF1</outgoing>
    </task>
    <task id="LRF1" name="Liberar Recursos Financeiros">
      <incoming>RGREP1-LRF1</incoming>
      <outgoing>LRF1-EPF1</outgoing>
    </task>
    <task id="EPF1" name="Efetuar Pagamento ao Fornecedor">
      <incoming>LRF1-EPF1</incoming>
      <outgoing>EPF1-XORCLOSE20</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE20" name="XORCLOSE20">
      <incoming>G1-XORCLOSE20</incoming>
      <incoming>EPF1-XORCLOSE20</incoming>
      <outgoing>XORCLOSE20-XORCLOSE21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="XORCLOSE21" name="XORCLOSE21">
      <incoming>G0-XORCLOSE21</incoming>
      <incoming>XORCLOSE20-XORCLOSE21</incoming>
      <outgoing>XORCLOSE21-END</outgoing>
    </exclusiveGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>XORCLOSE21-END</incoming>
    </endEvent>
    <exclusiveGateway id="XOR_JMPAA_RTPC1_RPC1" name="XOR_JMPAA_Retrabalhar Pedido de Compra">
      <incoming>RTPC1-XOR_JMPAA_RTPC1_RPC1</incoming>
      <outgoing>XOR_JMPAA_RTPC1_RPC1-APC1</outgoing>
      <outgoing>XOR_JMPAA_RTPC1_RPC1-XOR_JMPBB_RTPC1_RPC1</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="XOR_JMPBB_RTPC1_RPC1" name="XOR_JMPBB_Revisar Pedido de Compra">
      <incoming>CPC1-XOR_JMPBB_RTPC1_RPC1</incoming>
      <incoming>XOR_JMPAA_RTPC1_RPC1-XOR_JMPBB_RTPC1_RPC1</incoming>
      <outgoing>XOR_JMPBB_RTPC1_RPC1-RPC1</outgoing>
    </exclusiveGateway>
