  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-VC1</outgoing>
    </startEvent>
    <task id="VC1" name="Verificar Cliente">
      <incoming>Default_init-VC1</incoming>
      <outgoing>VC1-G0</outgoing>
