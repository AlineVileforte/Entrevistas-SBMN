      <outgoing>VP1-EPD2</outgoing>
    </task>
    <task id="EPD2" name="Encerrar Pedido">
      <incoming>VP1-EPD2</incoming>
      <outgoing>EPD2-VL1</outgoing>
    </task>
    <task id="VL1" name="Verificar os Lembretes">
