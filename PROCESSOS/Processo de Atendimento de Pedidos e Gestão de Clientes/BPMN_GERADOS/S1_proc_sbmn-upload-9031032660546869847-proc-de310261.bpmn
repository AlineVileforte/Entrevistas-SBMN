    <parallelGateway id="Par21" name="PAR">
      <incoming>PPE1-Par21</incoming>
      <outgoing>Par21-EP1</outgoing>
      <outgoing>Par21-PF1</outgoing>
    </parallelGateway>
    <task id="EP1" name="Embalar os Produtos">
      <incoming>Par21-EP1</incoming>
      <outgoing>EP1-EPD1</outgoing>
    </task>
    <task id="PF1" name="Preparar Fatura">
      <incoming>Par21-PF1</incoming>
      <outgoing>PF1-EFC1</outgoing>
    </task>
    <task id="EPD1" name="Entregar os Produtos">
      <incoming>EP1-EPD1</incoming>
      <outgoing>EPD1-PARCLOSE31</outgoing>
    </task>
    <task id="EFC1" name="Enviar a Fatura ao Cliente">
