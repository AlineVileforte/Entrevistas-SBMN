  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-VC1</outgoing>
    </startEvent>
    <task id="VC1" name="Verificar Cliente">
      <incoming>Default_init-VC1</incoming>
      <outgoing>VC1-G0</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>VC1-G0</incoming>
      <outgoing>G0-VHP1</outgoing>
      <outgoing>G0-VTC1</outgoing>
    </exclusiveGateway>
    <task id="VHP1" name="Verificar Histórico de Pagamentos">
      <incoming>G0-VHP1</incoming>
      <outgoing>VHP1-G1</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>VHP1-G1</incoming>
      <outgoing>G1-CNC1</outgoing>
      <outgoing>G1-G2</outgoing>
    </exclusiveGateway>
    <task id="CNC1" name="Criar Novo Cliente">
      <incoming>G1-CNC1</incoming>
      <outgoing>CNC1-VD1</outgoing>
    </task>
    <task id="VD1" name="Verificar Disponibilidade">
      <incoming>CNC1-VD1</incoming>
      <outgoing>VD1-ECC1</outgoing>
    </task>
    <exclusiveGateway id="G2" name="G2">
      <incoming>G1-G2</incoming>
      <outgoing>G2-EMR1</outgoing>
      <outgoing>G2-XORCLOSE20</outgoing>
    </exclusiveGateway>
    <task id="EMR1" name="Enviar Mensagem de Recusa">
      <incoming>G2-EMR1</incoming>
      <outgoing>EMR1-XORCLOSE20</outgoing>
    </task>
    <task id="VTC1" name="Verificar Tipo de Cliente">
      <incoming>G0-VTC1</incoming>
      <outgoing>VTC1-XORCLOSE34</outgoing>
    </task>
    <task id="ECC1" name="Enviar Confirmação ao Cliente">
      <incoming>VD1-ECC1</incoming>
      <outgoing>ECC1-G4</outgoing>
    </task>
    <exclusiveGateway id="G4" name="G4">
      <incoming>ECC1-G4</incoming>
      <outgoing>G4-PPF1</outgoing>
      <outgoing>G4-XORCLOSE32</outgoing>
    </exclusiveGateway>
    <task id="PPF1" name="Produzir Produtos em Falta">
