  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-Par0</outgoing>
    </startEvent>
    <parallelGateway id="Par0" name="PAR">
      <incoming>Default_init-Par0</incoming>
      <outgoing>Par0-CP1</outgoing>
      <outgoing>Par0-TIE1</outgoing>
    </parallelGateway>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Par0-CP1</incoming>
      <outgoing>CP1-RA1</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Par0-TIE1</incoming>
      <outgoing>TIE1-MAS1</outgoing>
    </task>
    <task id="RA1" name="Registro administrativo">
      <incoming>CP1-RA1</incoming>
      <outgoing>RA1-TAC1</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>TIE1-MAS1</incoming>
      <outgoing>MAS1-Par11</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>RA1-TAC1</incoming>
      <outgoing>TAC1-MCA1</outgoing>
    </task>
    <parallelGateway id="Par11" name="PAR">
      <incoming>MAS1-Par11</incoming>
      <outgoing>Par11-SE1</outgoing>
      <outgoing>Par11-G0</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>Par11-SE1</incoming>
      <outgoing>SE1-Par19</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>Par11-G0</incoming>
      <outgoing>G0-PPI1</outgoing>
      <outgoing>G0-XORCLOSE28</outgoing>
    </exclusiveGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>G0-PPI1</incoming>
      <outgoing>PPI1-XORCLOSE28</outgoing>
    </task>
    <parallelGateway id="Par19" name="PAR">
      <incoming>SE1-Par19</incoming>
      <outgoing>Par19-AMI1</outgoing>
      <outgoing>Par19-PRE1</outgoing>
    </parallelGateway>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par19-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>Par19-PRE1</incoming>
      <outgoing>PRE1-PARCLOSE27</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>TAC1-MCA1</incoming>
      <outgoing>MCA1-PARCLOSE33</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE27</outgoing>
    </task>
    <parallelGateway id="PARCLOSE27" name="PARCLOSE27">
      <incoming>PRE1-PARCLOSE27</incoming>
      <incoming>TEA1-PARCLOSE27</incoming>
      <outgoing>PARCLOSE27-RD1</outgoing>
    </parallelGateway>
    <exclusiveGateway id="XORCLOSE28" name="XORCLOSE28">
      <incoming>G0-XORCLOSE28</incoming>
      <incoming>PPI1-XORCLOSE28</incoming>
      <outgoing>XORCLOSE28-PARCLOSE32</outgoing>
    </exclusiveGateway>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PARCLOSE27-RD1</incoming>
      <outgoing>RD1-SEA1</outgoing>
    </task>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>RD1-SEA1</incoming>
      <outgoing>SEA1-CE1</outgoing>
    </task>
    <task id="CE1" name="Consultar especialista">
      <incoming>SEA1-CE1</incoming>
      <outgoing>CE1-PARCLOSE32</outgoing>
    </task>
    <parallelGateway id="PARCLOSE32" name="PARCLOSE32">
      <incoming>XORCLOSE28-PARCLOSE32</incoming>
      <incoming>CE1-PARCLOSE32</incoming>
      <outgoing>PARCLOSE32-PARCLOSE33</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE33" name="PARCLOSE33">
      <incoming>MCA1-PARCLOSE33</incoming>
      <incoming>PARCLOSE32-PARCLOSE33</incoming>
      <outgoing>PARCLOSE33-PPA1</outgoing>
    </parallelGateway>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>PARCLOSE33-PPA1</incoming>
      <outgoing>PPA1-EOF1</outgoing>
    </task>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>PPA1-EOF1</incoming>
      <outgoing>EOF1-END</outgoing>
    </task>
    <endEvent id="END" name="END_EVENT">
      <incoming>EOF1-END</incoming>
    </endEvent>
