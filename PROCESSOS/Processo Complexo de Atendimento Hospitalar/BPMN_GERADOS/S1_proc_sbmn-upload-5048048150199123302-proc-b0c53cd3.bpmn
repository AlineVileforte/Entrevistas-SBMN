    <exclusiveGateway id="XORCLOSE32" name="XORCLOSE32">
      <incoming>G4-XORCLOSE32</incoming>
      <incoming>CE1-XORCLOSE32</incoming>
      <outgoing>XORCLOSE32-XORCLOSE33</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="XORCLOSE33" name="XORCLOSE33">
      <incoming>EOF1-XORCLOSE33</incoming>
      <incoming>XORCLOSE32-XORCLOSE33</incoming>
      <outgoing>XORCLOSE33-PARCLOSE34</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE34" name="PARCLOSE34">
      <incoming>PARCLOSE27-PARCLOSE34</incoming>
      <incoming>XORCLOSE33-PARCLOSE34</incoming>
      <outgoing>PARCLOSE34-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE34-END</incoming>
    </endEvent>
