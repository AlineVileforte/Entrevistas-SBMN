  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-CP1</outgoing>
    </startEvent>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Default_init-CP1</incoming>
      <outgoing>CP1-RA1</outgoing>
    </task>
    <task id="RA1" name="Registro administrativo">
      <incoming>CP1-RA1</incoming>
      <outgoing>RA1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>RA1-Par2</incoming>
      <outgoing>Par2-MCA1</outgoing>
      <outgoing>Par2-TAC1</outgoing>
    </parallelGateway>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>Par2-MCA1</incoming>
      <outgoing>MCA1-TIE1</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>Par2-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE6</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>MCA1-TIE1</incoming>
      <outgoing>TIE1-PARCLOSE6</outgoing>
    </task>
    <parallelGateway id="PARCLOSE6" name="PARCLOSE6">
      <incoming>TAC1-PARCLOSE6</incoming>
      <incoming>TIE1-PARCLOSE6</incoming>
      <outgoing>PARCLOSE6-MAS1</outgoing>
    </parallelGateway>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>PARCLOSE6-MAS1</incoming>
      <outgoing>MAS1-Par8</outgoing>
    </task>
    <parallelGateway id="Par8" name="PAR">
      <incoming>MAS1-Par8</incoming>
      <outgoing>Par8-SE1</outgoing>
      <outgoing>Par8-PRE1</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>Par8-SE1</incoming>
      <outgoing>SE1-Par10</outgoing>
    </task>
    <parallelGateway id="Par10" name="PAR">
      <incoming>SE1-Par10</incoming>
      <outgoing>Par10-AMI1</outgoing>
      <outgoing>Par10-G1</outgoing>
    </parallelGateway>
    <exclusiveGateway id="G1" name="G1">
      <incoming>Par10-G1</incoming>
      <outgoing>G1-PPI1</outgoing>
      <outgoing>G1-XORCLOSE24</outgoing>
    </exclusiveGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>G1-PPI1</incoming>
      <outgoing>PPI1-PPA1</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>Par8-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par10-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>PPI1-PPA1</incoming>
      <outgoing>PPA1-XORCLOSE24</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-G2</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE27</outgoing>
    </task>
    <exclusiveGateway id="G2" name="G2">
      <incoming>RD1-G2</incoming>
      <outgoing>G2-SEA1</outgoing>
      <outgoing>G2-G4</outgoing>
    </exclusiveGateway>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>G2-SEA1</incoming>
      <outgoing>SEA1-EOF1</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE24" name="XORCLOSE24">
      <incoming>G1-XORCLOSE24</incoming>
      <incoming>PPA1-XORCLOSE24</incoming>
      <outgoing>XORCLOSE24-PARCLOSE27</outgoing>
    </exclusiveGateway>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>SEA1-EOF1</incoming>
      <outgoing>EOF1-XORCLOSE33</outgoing>
    </task>
    <parallelGateway id="PARCLOSE27" name="PARCLOSE27">
