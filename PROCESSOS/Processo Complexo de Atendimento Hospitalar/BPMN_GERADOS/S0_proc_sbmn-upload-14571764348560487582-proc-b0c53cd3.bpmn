  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-CP1</outgoing>
    </startEvent>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Default_init-CP1</incoming>
      <outgoing>CP1-Par1</outgoing>
    </task>
    <parallelGateway id="Par1" name="PAR">
      <incoming>CP1-Par1</incoming>
      <outgoing>Par1-RA1</outgoing>
      <outgoing>Par1-TIE1</outgoing>
    </parallelGateway>
    <task id="RA1" name="Registro administrativo">
      <incoming>Par1-RA1</incoming>
      <outgoing>RA1-MCA1</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Par1-TIE1</incoming>
      <outgoing>TIE1-MAS1</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>TIE1-MAS1</incoming>
      <outgoing>MAS1-Par7</outgoing>
    </task>
    <parallelGateway id="Par7" name="PAR">
      <incoming>MAS1-Par7</incoming>
      <outgoing>Par7-AMI1</outgoing>
      <outgoing>Par7-TEA1</outgoing>
    </parallelGateway>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par7-AMI1</incoming>
      <outgoing>AMI1-Par10</outgoing>
    </task>
    <parallelGateway id="Par10" name="PAR">
      <incoming>AMI1-Par10</incoming>
      <outgoing>Par10-PPI1</outgoing>
      <outgoing>Par10-SE1</outgoing>
    </parallelGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>Par10-PPI1</incoming>
      <outgoing>PPI1-PARCLOSE22</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>Par7-TEA1</incoming>
      <outgoing>TEA1-PRE1</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>RA1-MCA1</incoming>
      <outgoing>MCA1-TAC1</outgoing>
    </task>
    <task id="SE1" name="Solicitar exames">
      <incoming>Par10-SE1</incoming>
      <outgoing>SE1-PARCLOSE22</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>MCA1-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE28</outgoing>
    </task>
    <parallelGateway id="PARCLOSE22" name="PARCLOSE22">
      <incoming>PPI1-PARCLOSE22</incoming>
      <incoming>SE1-PARCLOSE22</incoming>
      <outgoing>PARCLOSE22-PARCLOSE25</outgoing>
    </parallelGateway>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>TEA1-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-PARCLOSE25</outgoing>
    </task>
    <parallelGateway id="PARCLOSE25" name="PARCLOSE25">
      <incoming>PARCLOSE22-PARCLOSE25</incoming>
      <incoming>RD1-PARCLOSE25</incoming>
      <outgoing>PARCLOSE25-SEA1</outgoing>
    </parallelGateway>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>PARCLOSE25-SEA1</incoming>
      <outgoing>SEA1-CE1</outgoing>
    </task>
    <task id="CE1" name="Consultar especialista">
      <incoming>SEA1-CE1</incoming>
      <outgoing>CE1-PARCLOSE28</outgoing>
    </task>
    <parallelGateway id="PARCLOSE28" name="PARCLOSE28">
      <incoming>TAC1-PARCLOSE28</incoming>
      <incoming>CE1-PARCLOSE28</incoming>
      <outgoing>PARCLOSE28-Par29</outgoing>
    </parallelGateway>
    <parallelGateway id="Par29" name="PAR">
      <incoming>PARCLOSE28-Par29</incoming>
      <outgoing>Par29-EOF1</outgoing>
      <outgoing>Par29-PPA1</outgoing>
    </parallelGateway>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>Par29-EOF1</incoming>
      <outgoing>EOF1-PARCLOSE32</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>Par29-PPA1</incoming>
      <outgoing>PPA1-PARCLOSE32</outgoing>
    </task>
    <parallelGateway id="PARCLOSE32" name="PARCLOSE32">
      <incoming>EOF1-PARCLOSE32</incoming>
      <incoming>PPA1-PARCLOSE32</incoming>
      <outgoing>PARCLOSE32-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE32-END</incoming>
    </endEvent>
