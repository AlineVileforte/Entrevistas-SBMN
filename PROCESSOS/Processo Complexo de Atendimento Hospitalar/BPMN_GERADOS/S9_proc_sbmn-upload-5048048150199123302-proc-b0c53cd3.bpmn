  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-CP1</outgoing>
    </startEvent>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Default_init-CP1</incoming>
      <outgoing>CP1-RA1</outgoing>
    </task>
    <task id="RA1" name="Registro administrativo">
      <incoming>CP1-RA1</incoming>
      <outgoing>RA1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>RA1-Par2</incoming>
      <outgoing>Par2-TIE1</outgoing>
      <outgoing>Par2-MAS1</outgoing>
    </parallelGateway>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Par2-TIE1</incoming>
      <outgoing>TIE1-TAC1</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>TIE1-TAC1</incoming>
      <outgoing>TAC1-MCA1</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>Par2-MAS1</incoming>
      <outgoing>MAS1-Par7</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>TAC1-MCA1</incoming>
      <outgoing>MCA1-SE1</outgoing>
    </task>
    <parallelGateway id="Par7" name="PAR">
      <incoming>MAS1-Par7</incoming>
      <outgoing>Par7-AMI1</outgoing>
      <outgoing>Par7-G0</outgoing>
    </parallelGateway>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par7-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>Par7-G0</incoming>
      <outgoing>G0-PPI1</outgoing>
      <outgoing>G0-XORCLOSE17</outgoing>
    </exclusiveGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>G0-PPI1</incoming>
      <outgoing>PPI1-XORCLOSE17</outgoing>
    </task>
    <task id="SE1" name="Solicitar exames">
      <incoming>MCA1-SE1</incoming>
      <outgoing>SE1-PRE1</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE20</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>SE1-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-G1</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE17" name="XORCLOSE17">
      <incoming>G0-XORCLOSE17</incoming>
      <incoming>PPI1-XORCLOSE17</incoming>
      <outgoing>XORCLOSE17-PARCLOSE20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="G1" name="G1">
      <incoming>RD1-G1</incoming>
      <outgoing>G1-SEA1</outgoing>
      <outgoing>G1-G2</outgoing>
    </exclusiveGateway>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>G1-SEA1</incoming>
      <outgoing>SEA1-EOF1</outgoing>
    </task>
    <parallelGateway id="PARCLOSE20" name="PARCLOSE20">
      <incoming>TEA1-PARCLOSE20</incoming>
      <incoming>XORCLOSE17-PARCLOSE20</incoming>
      <outgoing>PARCLOSE20-PPA1</outgoing>
    </parallelGateway>
    <exclusiveGateway id="G2" name="G2">
      <incoming>G1-G2</incoming>
      <outgoing>G2-CE1</outgoing>
      <outgoing>G2-XORCLOSE29</outgoing>
    </exclusiveGateway>
    <task id="CE1" name="Consultar especialista">
      <incoming>G2-CE1</incoming>
      <outgoing>CE1-XORCLOSE29</outgoing>
    </task>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>SEA1-EOF1</incoming>
      <outgoing>EOF1-XORCLOSE31</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>PARCLOSE20-PPA1</incoming>
      <outgoing>PPA1-PARCLOSE32</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE29" name="XORCLOSE29">
      <incoming>G2-XORCLOSE29</incoming>
      <incoming>CE1-XORCLOSE29</incoming>
      <outgoing>XORCLOSE29-XORCLOSE31</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="XORCLOSE31" name="XORCLOSE31">
      <incoming>EOF1-XORCLOSE31</incoming>
      <incoming>XORCLOSE29-XORCLOSE31</incoming>
      <outgoing>XORCLOSE31-PARCLOSE32</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE32" name="PARCLOSE32">
      <incoming>PPA1-PARCLOSE32</incoming>
      <incoming>XORCLOSE31-PARCLOSE32</incoming>
      <outgoing>PARCLOSE32-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE32-END</incoming>
    </endEvent>
