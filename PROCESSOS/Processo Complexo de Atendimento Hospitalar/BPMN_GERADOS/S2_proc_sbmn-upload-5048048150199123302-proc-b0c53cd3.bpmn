<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_2e17efa3-d0b6-48cd-9f8f-2a5eb213a7f7" targetNamespace="http://camunda.org/examples" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-Par0</outgoing>
    </startEvent>
    <parallelGateway id="Par0" name="PAR">
      <incoming>Default_init-Par0</incoming>
      <outgoing>Par0-CP1</outgoing>
      <outgoing>Par0-TIE1</outgoing>
    </parallelGateway>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Par0-CP1</incoming>
      <outgoing>CP1-RA1</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Par0-TIE1</incoming>
      <outgoing>TIE1-MAS1</outgoing>
    </task>
    <task id="RA1" name="Registro administrativo">
      <incoming>CP1-RA1</incoming>
      <outgoing>RA1-MCA1</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>TIE1-MAS1</incoming>
      <outgoing>MAS1-G0</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>RA1-MCA1</incoming>
      <outgoing>MCA1-TAC1</outgoing>
    </task>
    <exclusiveGateway id="G0" name="G0">
      <incoming>MAS1-G0</incoming>
      <outgoing>G0-XORCLOSE17</outgoing>
      <outgoing>G0-PPI1</outgoing>
    </exclusiveGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>G0-PPI1</incoming>
      <outgoing>PPI1-XORCLOSE17</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE17" name="XORCLOSE17">
      <incoming>G0-XORCLOSE17</incoming>
      <incoming>PPI1-XORCLOSE17</incoming>
      <outgoing>XORCLOSE17-AMI1</outgoing>
    </exclusiveGateway>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>MCA1-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE23</outgoing>
    </task>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>XORCLOSE17-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE23</outgoing>
    </task>
    <parallelGateway id="PARCLOSE23" name="PARCLOSE23">
      <incoming>TAC1-PARCLOSE23</incoming>
      <incoming>TEA1-PARCLOSE23</incoming>
      <outgoing>PARCLOSE23-SE1</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>PARCLOSE23-SE1</incoming>
      <outgoing>SE1-PRE1</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>SE1-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-G1</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>RD1-G1</incoming>
      <outgoing>G1-CE1</outgoing>
      <outgoing>G1-SEA1</outgoing>
    </exclusiveGateway>
    <task id="CE1" name="Consultar especialista">
      <incoming>G1-CE1</incoming>
      <outgoing>CE1-XORCLOSE31</outgoing>
    </task>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>G1-SEA1</incoming>
      <outgoing>SEA1-EOF1</outgoing>
    </task>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>SEA1-EOF1</incoming>
      <outgoing>EOF1-XORCLOSE31</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE31" name="XORCLOSE31">
      <incoming>CE1-XORCLOSE31</incoming>
      <incoming>EOF1-XORCLOSE31</incoming>
      <outgoing>XORCLOSE31-PPA1</outgoing>
    </exclusiveGateway>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>XORCLOSE31-PPA1</incoming>
      <outgoing>PPA1-END</outgoing>
    </task>
    <endEvent id="END" name="END_EVENT">
      <incoming>PPA1-END</incoming>
    </endEvent>
