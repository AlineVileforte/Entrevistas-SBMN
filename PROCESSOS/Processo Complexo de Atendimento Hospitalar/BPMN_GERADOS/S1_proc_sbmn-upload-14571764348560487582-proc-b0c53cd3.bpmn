  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-TIE1</outgoing>
    </startEvent>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Default_init-TIE1</incoming>
      <outgoing>TIE1-Par1</outgoing>
    </task>
    <parallelGateway id="Par1" name="PAR">
      <incoming>TIE1-Par1</incoming>
      <outgoing>Par1-CP1</outgoing>
      <outgoing>Par1-MAS1</outgoing>
    </parallelGateway>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Par1-CP1</incoming>
      <outgoing>CP1-Par4</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>Par1-MAS1</incoming>
      <outgoing>MAS1-SE1</outgoing>
    </task>
    <parallelGateway id="Par4" name="PAR">
      <incoming>CP1-Par4</incoming>
      <outgoing>Par4-RA1</outgoing>
      <outgoing>Par4-MCA1</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>MAS1-SE1</incoming>
      <outgoing>SE1-PPI1</outgoing>
    </task>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>SE1-PPI1</incoming>
      <outgoing>PPI1-Par17</outgoing>
    </task>
    <task id="RA1" name="Registro administrativo">
      <incoming>Par4-RA1</incoming>
      <outgoing>RA1-TAC1</outgoing>
    </task>
    <parallelGateway id="Par17" name="PAR">
      <incoming>PPI1-Par17</incoming>
      <outgoing>Par17-AMI1</outgoing>
      <outgoing>Par17-PRE1</outgoing>
    </parallelGateway>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par17-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>Par17-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>RA1-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE25</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>Par4-MCA1</incoming>
      <outgoing>MCA1-PARCLOSE25</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE26</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-PARCLOSE26</outgoing>
    </task>
    <parallelGateway id="PARCLOSE25" name="PARCLOSE25">
      <incoming>TAC1-PARCLOSE25</incoming>
      <incoming>MCA1-PARCLOSE25</incoming>
      <outgoing>PARCLOSE25-PARCLOSE30</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE26" name="PARCLOSE26">
      <incoming>TEA1-PARCLOSE26</incoming>
      <incoming>RD1-PARCLOSE26</incoming>
      <outgoing>PARCLOSE26-SEA1</outgoing>
    </parallelGateway>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>PARCLOSE26-SEA1</incoming>
      <outgoing>SEA1-CE1</outgoing>
    </task>
    <task id="CE1" name="Consultar especialista">
      <incoming>SEA1-CE1</incoming>
      <outgoing>CE1-PARCLOSE30</outgoing>
    </task>
    <parallelGateway id="PARCLOSE30" name="PARCLOSE30">
      <incoming>PARCLOSE25-PARCLOSE30</incoming>
      <incoming>CE1-PARCLOSE30</incoming>
      <outgoing>PARCLOSE30-Par31</outgoing>
    </parallelGateway>
    <parallelGateway id="Par31" name="PAR">
      <incoming>PARCLOSE30-Par31</incoming>
      <outgoing>Par31-EOF1</outgoing>
      <outgoing>Par31-PPA1</outgoing>
    </parallelGateway>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>Par31-EOF1</incoming>
      <outgoing>EOF1-PARCLOSE34</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>Par31-PPA1</incoming>
      <outgoing>PPA1-PARCLOSE34</outgoing>
    </task>
    <parallelGateway id="PARCLOSE34" name="PARCLOSE34">
      <incoming>EOF1-PARCLOSE34</incoming>
      <incoming>PPA1-PARCLOSE34</incoming>
      <outgoing>PARCLOSE34-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE34-END</incoming>
    </endEvent>
