  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-CP1</outgoing>
    </startEvent>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Default_init-CP1</incoming>
      <outgoing>CP1-TIE1</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>CP1-TIE1</incoming>
      <outgoing>TIE1-Par2</outgoing>
    </task>
    <parallelGateway id="Par2" name="PAR">
      <incoming>TIE1-Par2</incoming>
      <outgoing>Par2-RA1</outgoing>
      <outgoing>Par2-MAS1</outgoing>
    </parallelGateway>
    <task id="RA1" name="Registro administrativo">
      <incoming>Par2-RA1</incoming>
      <outgoing>RA1-MCA1</outgoing>
    </task>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>Par2-MAS1</incoming>
      <outgoing>MAS1-Par6</outgoing>
    </task>
    <parallelGateway id="Par6" name="PAR">
      <incoming>MAS1-Par6</incoming>
      <outgoing>Par6-SE1</outgoing>
      <outgoing>Par6-AMI1</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>Par6-SE1</incoming>
      <outgoing>SE1-Par12</outgoing>
    </task>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>Par6-AMI1</incoming>
      <outgoing>AMI1-TEA1</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>RA1-MCA1</incoming>
      <outgoing>MCA1-TAC1</outgoing>
    </task>
    <parallelGateway id="Par12" name="PAR">
      <incoming>SE1-Par12</incoming>
      <outgoing>Par12-G1</outgoing>
      <outgoing>Par12-PRE1</outgoing>
    </parallelGateway>
    <exclusiveGateway id="G1" name="G1">
      <incoming>Par12-G1</incoming>
      <outgoing>G1-PPI1</outgoing>
      <outgoing>G1-XORCLOSE24</outgoing>
    </exclusiveGateway>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>G1-PPI1</incoming>
      <outgoing>PPI1-XORCLOSE24</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>AMI1-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE26</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>MCA1-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE29</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>Par12-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-PARCLOSE25</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE24" name="XORCLOSE24">
      <incoming>G1-XORCLOSE24</incoming>
      <incoming>PPI1-XORCLOSE24</incoming>
      <outgoing>XORCLOSE24-PARCLOSE25</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE25" name="PARCLOSE25">
      <incoming>RD1-PARCLOSE25</incoming>
      <incoming>XORCLOSE24-PARCLOSE25</incoming>
      <outgoing>PARCLOSE25-PARCLOSE26</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE26" name="PARCLOSE26">
      <incoming>TEA1-PARCLOSE26</incoming>
      <incoming>PARCLOSE25-PARCLOSE26</incoming>
      <outgoing>PARCLOSE26-CE1</outgoing>
    </parallelGateway>
    <task id="CE1" name="Consultar especialista">
      <incoming>PARCLOSE26-CE1</incoming>
      <outgoing>CE1-SEA1</outgoing>
    </task>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>CE1-SEA1</incoming>
      <outgoing>SEA1-PARCLOSE29</outgoing>
    </task>
    <parallelGateway id="PARCLOSE29" name="PARCLOSE29">
      <incoming>TAC1-PARCLOSE29</incoming>
      <incoming>SEA1-PARCLOSE29</incoming>
      <outgoing>PARCLOSE29-Par30</outgoing>
    </parallelGateway>
    <parallelGateway id="Par30" name="PAR">
      <incoming>PARCLOSE29-Par30</incoming>
      <outgoing>Par30-EOF1</outgoing>
      <outgoing>Par30-PPA1</outgoing>
    </parallelGateway>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>Par30-EOF1</incoming>
      <outgoing>EOF1-PARCLOSE33</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>Par30-PPA1</incoming>
      <outgoing>PPA1-PARCLOSE33</outgoing>
    </task>
    <parallelGateway id="PARCLOSE33" name="PARCLOSE33">
      <incoming>EOF1-PARCLOSE33</incoming>
      <incoming>PPA1-PARCLOSE33</incoming>
      <outgoing>PARCLOSE33-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE33-END</incoming>
    </endEvent>
