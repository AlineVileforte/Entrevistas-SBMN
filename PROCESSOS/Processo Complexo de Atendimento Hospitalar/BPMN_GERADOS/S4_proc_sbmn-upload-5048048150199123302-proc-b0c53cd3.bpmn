      <incoming>MCA1-PARCLOSE20</incoming>
      <outgoing>PARCLOSE20-PARCLOSE30</outgoing>
    </parallelGateway>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>SE1-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <parallelGateway id="PARCLOSE23" name="PARCLOSE23">
      <incoming>PPI1-PARCLOSE23</incoming>
      <incoming>AMI1-PARCLOSE23</incoming>
      <outgoing>PARCLOSE23-TEA1</outgoing>
    </parallelGateway>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-CE1</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>PARCLOSE23-TEA1</incoming>
      <outgoing>TEA1-SEA1</outgoing>
    </task>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>TEA1-SEA1</incoming>
      <outgoing>SEA1-PARCLOSE29</outgoing>
    </task>
    <task id="CE1" name="Consultar especialista">
      <incoming>RD1-CE1</incoming>
      <outgoing>CE1-PARCLOSE29</outgoing>
    </task>
    <parallelGateway id="PARCLOSE29" name="PARCLOSE29">
      <incoming>SEA1-PARCLOSE29</incoming>
      <incoming>CE1-PARCLOSE29</incoming>
      <outgoing>PARCLOSE29-PARCLOSE30</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE30" name="PARCLOSE30">
      <incoming>PARCLOSE20-PARCLOSE30</incoming>
      <incoming>PARCLOSE29-PARCLOSE30</incoming>
      <outgoing>PARCLOSE30-EOF1</outgoing>
    </parallelGateway>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>PARCLOSE30-EOF1</incoming>
      <outgoing>EOF1-PPA1</outgoing>
    </task>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>EOF1-PPA1</incoming>
      <outgoing>PPA1-END</outgoing>
    </task>
    <endEvent id="END" name="END_EVENT">
      <incoming>PPA1-END</incoming>
    </endEvent>
