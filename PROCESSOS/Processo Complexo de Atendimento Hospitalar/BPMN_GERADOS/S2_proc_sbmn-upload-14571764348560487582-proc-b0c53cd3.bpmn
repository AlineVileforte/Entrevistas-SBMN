  <process id="process">
    <startEvent id="Default_init" name="Default_init">
      <outgoing>Default_init-CP1</outgoing>
    </startEvent>
    <task id="CP1" name="Chegada do paciente">
      <incoming>Default_init-CP1</incoming>
      <outgoing>CP1-Par1</outgoing>
    </task>
    <parallelGateway id="Par1" name="PAR">
      <incoming>CP1-Par1</incoming>
      <outgoing>Par1-RA1</outgoing>
      <outgoing>Par1-TIE1</outgoing>
    </parallelGateway>
    <task id="RA1" name="Registro administrativo">
      <incoming>Par1-RA1</incoming>
      <outgoing>RA1-Par4</outgoing>
    </task>
    <task id="TIE1" name="Triagem inicial de enfermagem">
      <incoming>Par1-TIE1</incoming>
      <outgoing>TIE1-MAS1</outgoing>
    </task>
    <parallelGateway id="Par4" name="PAR">
      <incoming>RA1-Par4</incoming>
      <outgoing>Par4-TAC1</outgoing>
      <outgoing>Par4-MCA1</outgoing>
    </parallelGateway>
    <task id="MAS1" name="Médico analisa os sintomas">
      <incoming>TIE1-MAS1</incoming>
      <outgoing>MAS1-PPI1</outgoing>
    </task>
    <task id="TAC1" name="Tratar autorização do convênio">
      <incoming>Par4-TAC1</incoming>
      <outgoing>TAC1-PARCLOSE19</outgoing>
    </task>
    <task id="MCA1" name="Monitorar custos e aprovações">
      <incoming>Par4-MCA1</incoming>
      <outgoing>MCA1-PARCLOSE19</outgoing>
    </task>
    <task id="PPI1" name="Preparar procedimentos de Internação">
      <incoming>MAS1-PPI1</incoming>
      <outgoing>PPI1-AMI1</outgoing>
    </task>
    <task id="AMI1" name="Administrar medicação inicial">
      <incoming>PPI1-AMI1</incoming>
      <outgoing>AMI1-PARCLOSE20</outgoing>
    </task>
    <parallelGateway id="PARCLOSE19" name="PARCLOSE19">
      <incoming>TAC1-PARCLOSE19</incoming>
      <incoming>MCA1-PARCLOSE19</incoming>
      <outgoing>PARCLOSE19-PARCLOSE20</outgoing>
    </parallelGateway>
    <parallelGateway id="PARCLOSE20" name="PARCLOSE20">
      <incoming>AMI1-PARCLOSE20</incoming>
      <incoming>PARCLOSE19-PARCLOSE20</incoming>
      <outgoing>PARCLOSE20-Par21</outgoing>
    </parallelGateway>
    <parallelGateway id="Par21" name="PAR">
      <incoming>PARCLOSE20-Par21</incoming>
      <outgoing>Par21-SE1</outgoing>
      <outgoing>Par21-TEA1</outgoing>
    </parallelGateway>
    <task id="SE1" name="Solicitar exames">
      <incoming>Par21-SE1</incoming>
      <outgoing>SE1-PRE1</outgoing>
    </task>
    <task id="TEA1" name="Tratamento em andamento">
      <incoming>Par21-TEA1</incoming>
      <outgoing>TEA1-PARCLOSE26</outgoing>
    </task>
    <task id="PRE1" name="Processar/realizar exames">
      <incoming>SE1-PRE1</incoming>
      <outgoing>PRE1-RD1</outgoing>
    </task>
    <task id="RD1" name="Revisar diagnóstico">
      <incoming>PRE1-RD1</incoming>
      <outgoing>RD1-PARCLOSE26</outgoing>
    </task>
    <parallelGateway id="PARCLOSE26" name="PARCLOSE26">
      <incoming>TEA1-PARCLOSE26</incoming>
      <incoming>RD1-PARCLOSE26</incoming>
      <outgoing>PARCLOSE26-Par27</outgoing>
    </parallelGateway>
    <parallelGateway id="Par27" name="PAR">
      <incoming>PARCLOSE26-Par27</incoming>
      <outgoing>Par27-PPA1</outgoing>
      <outgoing>Par27-G1</outgoing>
    </parallelGateway>
    <task id="PPA1" name="Preparar procedimentos de alta">
      <incoming>Par27-PPA1</incoming>
      <outgoing>PPA1-PARCLOSE34</outgoing>
    </task>
    <exclusiveGateway id="G1" name="G1">
      <incoming>Par27-G1</incoming>
      <outgoing>G1-CE1</outgoing>
      <outgoing>G1-SEA1</outgoing>
    </exclusiveGateway>
    <task id="CE1" name="Consultar especialista">
      <incoming>G1-CE1</incoming>
      <outgoing>CE1-XORCLOSE33</outgoing>
    </task>
    <task id="SEA1" name="Solicitar exames adicionais">
      <incoming>G1-SEA1</incoming>
      <outgoing>SEA1-EOF1</outgoing>
    </task>
    <task id="EOF1" name="Entregar orientações finais">
      <incoming>SEA1-EOF1</incoming>
      <outgoing>EOF1-XORCLOSE33</outgoing>
    </task>
    <exclusiveGateway id="XORCLOSE33" name="XORCLOSE33">
      <incoming>CE1-XORCLOSE33</incoming>
      <incoming>EOF1-XORCLOSE33</incoming>
      <outgoing>XORCLOSE33-PARCLOSE34</outgoing>
    </exclusiveGateway>
    <parallelGateway id="PARCLOSE34" name="PARCLOSE34">
      <incoming>PPA1-PARCLOSE34</incoming>
      <incoming>XORCLOSE33-PARCLOSE34</incoming>
      <outgoing>PARCLOSE34-END</outgoing>
    </parallelGateway>
    <endEvent id="END" name="END_EVENT">
      <incoming>PARCLOSE34-END</incoming>
    </endEvent>
